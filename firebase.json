{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/wow-token",
        "function": "getwowtokenprice"
      },
      {
        "source": "/api/item",
        "function": "getitemdetails"
      },
      {
        "source": "/api/auction-price",
        "function": "getauctionprice"
      },
      {
        "source": "/api/auction-prices",
        "function": "getmultipleauctionprices"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "emulators": {
    "functions": {
      "port": 5002
    },
    "firestore": {
      "port": 8089
    },
    "hosting": {
      "port": 5005
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
